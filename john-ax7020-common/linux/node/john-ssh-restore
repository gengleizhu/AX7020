#!/bin/sh
# Restore this board's provisioned SSH identity before Dropbear starts.
set -eu
BOOT=/media/sd-mmcblk0p1
SOURCE=$BOOT/john-ssh
grep -q " $BOOT " /proc/mounts || exit 0
umask 077
if [ -s "$SOURCE/dropbear_rsa_host_key" ]; then
    mkdir -p /etc/dropbear
    cp "$SOURCE/dropbear_rsa_host_key" /etc/dropbear/dropbear_rsa_host_key
    chmod 600 /etc/dropbear/dropbear_rsa_host_key
fi
if [ -s "$SOURCE/authorized_keys" ]; then
    mkdir -p /home/root/.ssh
    cp "$SOURCE/authorized_keys" /home/root/.ssh/authorized_keys
    chmod 700 /home/root/.ssh
    chmod 600 /home/root/.ssh/authorized_keys
fi
